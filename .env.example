# Server-side only. Never place this value in browser code or commit .env.
# The cached therapeutic demo works without a key. Add a key and restart the
# server to enable optional verified evidence extraction via the Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Alternative, takes precedence when set: OpenAI's open-weight gpt-oss-120b
# served by Cerebras (Chat Completions transport).
CEREBRAS_API_KEY=
# Optional: raises the NCBI E-utilities rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
# Pulse checks public paper and trial records every six hours while the server
# is running. New records stay unreviewed and never change therapeutic ranks.
CONSTELLAI_PULSE_ENABLED=1
# Optional quote-checked AI drafts for at most three paper abstracts per run.
# Requires OPENAI_API_KEY or CEREBRAS_API_KEY. Drafts still require human review before curation.
CONSTELLAI_PULSE_AI_ENABLED=0
