# Enables the AI steps (extraction, reconciliation, explanations, trial screening).
# Preferred: OpenAI's open-weight gpt-oss-120b served by Cerebras.
CEREBRAS_API_KEY=
# Fallback: the OpenAI API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Without either key the atlas runs in deterministic "template" mode.
# Optional: raises the NCBI E-utilities rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
